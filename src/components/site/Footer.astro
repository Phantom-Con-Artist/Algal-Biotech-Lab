---
import { Image } from 'astro:assets';
import ablLogo from '../../assets/logos/abl-mark.png';
import cutnLogo from '../../assets/logos/cutnlogo__1_-removebg-preview.png';
import Icon from './Icon.astro';
import { NAV, DEPARTMENT } from '../../data/site';
import { LAB_INFO, DEVELOPER } from '../../data/labData';
import { PI } from '../../data/members';
import { INQUIRY_TEMPLATES, mailto } from '../../data/inquiries';

interface Props { cta?: boolean }
const { cta = true } = Astro.props;
const year = new Date().getFullYear();
---
{cta && (
  <section class="pre-footer" aria-labelledby="prefooter-title">
    <div class="wrap">
      <div class="pre-footer__grid">
        <div>
          <h2 id="prefooter-title" class="sr-only">Contact</h2>
          <a class="pre-footer__mail" href={`mailto:${LAB_INFO.email}`} data-no-barba><span class="draw">{LAB_INFO.email}</span></a>
          <p class="pre-footer__where">Thiruvarur, Tamil Nadu. Collaborations and student enquiries welcome.</p>
        </div>
        <a class="pre-footer__go" href={mailto(INQUIRY_TEMPLATES[0].subject, INQUIRY_TEMPLATES[0].body)} data-no-barba>
          Start a collaboration <Icon name="arrow-up" />
        </a>
      </div>
    </div>
  </section>
)}

<footer class="footer dark" data-theme="dark">
  <div class="wrap">
    <nav class="footer__top-links" aria-label="Elsewhere">
      <a href={LAB_INFO.website} target="_blank" rel="noopener">CUTN</a>
      {PI.links.scholar && <a href={PI.links.scholar} target="_blank" rel="noopener">Google Scholar</a>}
      {PI.links.orcid && <a href={PI.links.orcid} target="_blank" rel="noopener">ORCID</a>}
      {PI.links.researchGate && <a href={PI.links.researchGate} target="_blank" rel="noopener">ResearchGate</a>}
      {PI.links.linkedin && <a href={PI.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>}
    </nav>

    <p class="footer__intro">Have a question about our work, or want to join the lab? Start with an email.</p>
    <a class="footer__mail" href={`mailto:${LAB_INFO.email}`} data-no-barba><span class="draw">{LAB_INFO.email}</span></a>

    <div class="footer__cols">
      <div>
        <h2>Algal Biotechnology Laboratory</h2>
        <ul>
          <li>{DEPARTMENT}</li>
          <li>{LAB_INFO.institution}</li>
          <li>{LAB_INFO.address[0]}</li>
          <li>{LAB_INFO.address[1]}</li>
        </ul>
      </div>
      <div>
        <h2>Pages</h2>
        <ul>{NAV.map((n) => <li><a href={n.href} data-label={n.label}><span class="draw">{n.label}</span></a></li>)}</ul>
      </div>
      <div>
        <h2>Enquiries</h2>
        <ul>
          <li><a href={mailto(INQUIRY_TEMPLATES[0].subject, INQUIRY_TEMPLATES[0].body)} data-no-barba><span class="draw">Collaboration</span></a></li>
          <li><a href={mailto(INQUIRY_TEMPLATES[1].subject, INQUIRY_TEMPLATES[1].body)} data-no-barba><span class="draw">Prospective students</span></a></li>
          <li><a href={LAB_INFO.phoneHref} data-no-barba><span class="draw">{LAB_INFO.phone}</span></a></li>
        </ul>
      </div>
      <div>
        <h2>Visit</h2>
        <ul>
          <li><a href={LAB_INFO.mapHref} target="_blank" rel="noopener"><span class="draw">Directions</span></a></li>
          <li><a href="/lab" data-label="The Lab"><span class="draw">The laboratory</span></a></li>
          <li><button class="footer__replay" type="button" data-replay-intro><span class="draw">Watch the intro film</span></button></li>
        </ul>
      </div>
    </div>

    <div class="footer__base">
      <div class="footer__logos">
        <Image src={ablLogo} alt="Algal Biotechnology Laboratory logo" width={88} />
        <Image src={cutnLogo} alt="Central University of Tamil Nadu crest" width={88} />
        <span>© {year} Algal Biotechnology Laboratory, CUTN</span>
      </div>
      <span>Website by <a href={DEVELOPER.url} target="_blank" rel="noopener">{DEVELOPER.studio}</a> ({DEVELOPER.name}, <a href={`mailto:${DEVELOPER.email}`} data-no-barba>{DEVELOPER.email}</a>)</span>
    </div>
  </div>
</footer>
